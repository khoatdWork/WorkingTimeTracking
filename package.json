    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.4",
